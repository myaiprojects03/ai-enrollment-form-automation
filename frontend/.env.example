# Copy to frontend/.env.local. Without PORTAL_DATABASE_URL the portals keep submissions in memory.
PORTAL_DATABASE_URL=postgresql://enroll:enroll@localhost:5433/portals
# Sent by machine callers as X-Portal-Key (the engine's API path and read-back). Required in production.
PORTAL_API_KEY=dev-portal-key
# The review console reaches the engine from the server side.
ENGINE_URL=http://localhost:8000
