# Copy to .env (never commit .env). Generate the three secrets with:  cd backend && python -m scripts.keys
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://enroll:enroll@localhost:5433/enroll
# Empty means in-memory (one process only). Production needs Redis (Upstash uses rediss://).
REDIS_URL=redis://localhost:6380/0

# AES-256-GCM keys, comma-separated, newest first (old keys stay listed so older rows still open).
ENCRYPTION_KEYS=
# HMAC key for duplicate detection fingerprints. Changing it breaks matching against older rows.
FINGERPRINT_KEY=
# Bearer token for machine callers (n8n, scripts). People sign in to the console instead.
OPERATOR_TOKEN=
# Review console sign-in: comma-separated entries from `python -m scripts.staff you@example.com`,
# and the secret that signs sessions (from scripts.keys).
STAFF_ACCOUNTS=
SESSION_SECRET=

# AI field mapping. groq (free: console.groq.com, no card), anthropic, auto, or none (rules only).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Free text (notes, letters) is sent to the model to be read. false = free text always goes to a person.
LLM_FREE_TEXT=true
# Fields mapped below this confidence go to a person.
REVIEW_THRESHOLD=0.85

# Signed webhook (POST /api/webhooks/intake). Any long random string; empty turns the webhook off.
WEBHOOK_SECRET=

# Submission. The portals' address, and the key their APIs expect (the same as PORTAL_API_KEY in frontend/.env.local).
PORTAL_BASE_URL=http://localhost:3000
PORTAL_API_KEY=dev-portal-key
BROWSER_HEADLESS=true
SUBMIT_MAX_ATTEMPTS=3
SUBMIT_BACKOFF_S=2
# Lets a submit ask for ?variant=b or ?chaos=... (demos and tests). Always off when APP_ENV=production.
ALLOW_TEST_MODES=true

# Optional: a Slack / Teams / Discord / Google Chat incoming-webhook URL for the n8n alerts and morning digest.
ALERT_WEBHOOK_URL=

# Deployment: SUBMIT_MODE=dispatch hands web-form submissions to the GitHub Actions worker (docs/DEPLOY.md).
SUBMIT_MODE=inline
GITHUB_DISPATCH_REPO=
GITHUB_DISPATCH_TOKEN=
RETENTION_DAYS=90
